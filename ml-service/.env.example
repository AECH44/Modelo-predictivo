# Puerto del servidor uvicorn (default: 8000)
UVICORN_PORT=8000

# Host de bind (default: 127.0.0.1 - servicio interno)
UVICORN_HOST=127.0.0.1

# Ruta al modelo entrenado (relativa al root del monorepo)
MODEL_PATH=ml-training/trained_models/saberpro_model.pkl

# Conexión a BD (solo si train_from_real.py corre desde aquí, normalmente corre desde ml-training/)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=saberpro
DB_USER=postgres
DB_PASSWORD=modelopredictivo
