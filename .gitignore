# =============================================================================
# Modelo Predictivo Saber Pro — .gitignore
# =============================================================================

# ---------- Dependencias ----------
node_modules/
*/node_modules/
.venv/
*/.venv/

# ---------- Builds y artefactos generados ----------
dist/
build/
*/dist/
*/build/

# ---------- Artefactos del modelo ----------
# Los .pkl de los modelos son binarios pesados y se regeneran con
# `docker compose --profile train run --rm ml-training`; NO se versionan.
# (ml-training/data/ SI se versiona: el background sample lo necesita el
# servicio ml-service para el SHAP.)
ml-training/trained_models/

# Las metricas del entrenamiento y los graficos del analisis SI se versionan:
# el panel "Analisis del modelo" del administrador los lee del disco, y si
# no viajan en el repositorio el panel aparece vacio en produccion.
# Solo se versionan los graficos del modelo v2 (los del v1 quedaron obsoletos:
# eran de un clasificador de bandas y el modelo actual es una regresion).
ml-training/analysis/*.png
!ml-training/analysis/v2_*.png

# ---------- Logs ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Variables de entorno (secretos, NUNCA commitear) ----------
.env
.env.local
.env.*.local
*/.env
!*/.env.example

# ---------- Python ----------
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.pytest_cache/

# ---------- OS / editor ----------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*.swn

# ---------- Datos sensibles / logs de procesamiento ----------
**/credenciales_generadas.csv
**/estudiantes_ingenieria.csv
**/estudiantes_limpio.csv
**/reporte_procesamiento.csv
**/procesamiento_detalle.json

# ---------- Scripts y artefactos de debug/prueba temporales ----------
**/debug_*.py
**/debug_*.txt
**/prueba_*.js

# ---------- Resultados de ejecucion ----------
resultados_prediccion_bd.json
**/resultados_prediccion_bd.json

# ---------- Backups y datos pesados (regenerables) ----------
# Mantener backup/tmp_backup_pre_limpieza.sql versionado por seguridad
# data/ y backup/ se versionan completos porque son pequeñas y utiles

# ---------- Estructura de carpetas esperada ----------
# Raíz:
#   README.md, .gitignore, .env.example
#   .claude/                     (config Claude local, no versionado)
#   data/                        (CSV dataset)
#   backup/                      (snapshots de BD)
#   docs/                        (documentación)
#   frontend/                    (React + Vite)
#   backend/                     (Express + PostgreSQL)
#   ml-service/                  (FastAPI - servicio de predicción)
#   ml-training/                 (pipeline de entrenamiento Python)
